## NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_PLAYER_DASHBOARD_URL=

## Neon (Postgres)
DATABASE_URL=

## Vercel Blob
BLOB_READ_WRITE_TOKEN=

## Admin
SECURITY_CODE=
# Owner-only code gating the Owner Admin sections (players, accounts, group
# training, waivers, challenges, booking requests). Unset = they stay locked.
# BOOKING_REQUESTS_CODE is still read as a fallback for older deployments.
OWNER_CODE=
BOOKING_REQUESTS_CODE=

## Cron
CRON_SECRET=

## Stripe Group Sessions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

## Group Signup Email Notifications
GMAIL_USER_GROUPS=
GMAIL_PASS_GROUPS=
GROUP_SIGNUP_ALERT_EMAIL=

## App Email Notifications
GMAIL_USER=
GMAIL_PASS=
RECIPIENT_EMAIL=

## Twilio Birthday Alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
BIRTHDAY_ALERT_TO_PHONE=
SIGNED_DOCUMENT_ALERT_TO_PHONE=
ORDER_ALERT_TO_PHONE=

# Set to "on" to let the hourly reminder cron text coaches. Anything else and
# reminders are generated but no SMS is sent.
COACH_REMINDER_SMS=

## CRM bridge — confirming a booking request creates the session in the CRM,
## which is what sends the Google Calendar invite, reminders and coach text.
CRM_BASE_URL=https://davids-soccer-training-crm.vercel.app
BRIDGE_SECRET=
